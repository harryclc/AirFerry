<Page x:Class="AirFerry.Windows.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="AirFerry - 设置"
      Background="{StaticResource BgDark}"
      MinWidth="640" MinHeight="560">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="设置"
                   FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimary}"
                   Margin="0,0,0,20" />

        <Border Grid.Row="1"
                Background="{StaticResource CardBg}"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="默认冗余率"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondary}" />
                <TextBlock x:Name="RedundancyText"
                           Text="5%"
                           FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"
                           Margin="0,4,0,8" />
                <Slider x:Name="RedundancySlider"
                        Minimum="5" Maximum="50"
                        TickFrequency="5" TickPlacement="BottomRight"
                        IsSnapToTickEnabled="True"
                        Value="5"
                        ValueChanged="Redundancy_Changed" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource CardBg}"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="屏幕捕获（DXGI Desktop Duplication）"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondary}" />
                <CheckBox x:Name="RoiEnabledCheck"
                          Content="启用 ROI（只裁剪二维码区域送入解码器）"
                          Foreground="{StaticResource TextPrimary}"
                          Margin="0,10,0,8"
                          Checked="Roi_Changed"
                          Unchecked="Roi_Changed" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X"
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,6,6" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="RoiXBox"
                             Width="80" HorizontalAlignment="Left"
                             TextChanged="Roi_Changed" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Y"
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" Margin="12,0,6,6" />
                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="RoiYBox"
                             Width="80" HorizontalAlignment="Left"
                             TextChanged="Roi_Changed" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="宽"
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="RoiWidthBox"
                             Width="80" HorizontalAlignment="Left"
                             TextChanged="Roi_Changed" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="高"
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" Margin="12,0,6,0" />
                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="RoiHeightBox"
                             Width="80" HorizontalAlignment="Left"
                             TextChanged="Roi_Changed" />
                </Grid>
                <TextBlock Text="ROI 默认关闭：整帧送入解码器；开启后按坐标裁剪（自动钳制到显示器边界）。"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Background="{StaticResource CardBg}"
                CornerRadius="12"
                Padding="20">
            <StackPanel>
                <TextBlock Text="AirFerry"
                           FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" />
                <TextBlock x:Name="VersionText"
                           Text="版本 1.0.0"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Button Grid.Row="5"
                Style="{StaticResource OutlinedButton}"
                Content="‹ 返回"
                Click="Back_Click" />
    </Grid>
</Page>
